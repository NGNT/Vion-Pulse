"""
cover_art_transfer.py

This module will provide functions to extract cover art (attached_pic streams) from an original video file
and apply it to a converted video file using FFmpeg.

Usage (to be implemented):
- extract_cover_art(input_file)
- apply_cover_art_to_output(input_file, output_file)
"""

import subprocess
import os
import tempfile
import shutil
import json

def get_attached_pic_indices(input_file):
 """Return a list of video stream indices flagged as attached_pic."""
 cmd = [
 'ffprobe', '-v', 'error',
 '-show_entries', 'stream=index,codec_type,disposition,codec_name',
 '-of', 'json', input_file
 ]
 res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
 data = json.loads(res.stdout or '{}')
 indices = []
 for s in data.get('streams', []):
 if s.get('codec_type') == 'video':
 disp = s.get('disposition') or {}
 if int(disp.get('attached_pic') or0) ==1:
 indices.append(int(s.get('index')))
 return indices

def extract_cover_art(input_file, output_dir=None):
 """Extract cover art stream(s) from input_file. Returns list of image file paths."""
 indices = get_attached_pic_indices(input_file)
 if not indices:
 return []
 if output_dir is None:
 output_dir = tempfile.mkdtemp()
 out_files = []
 for idx in indices:
 out_path = os.path.join(output_dir, f'cover_{idx}.jpg')
 cmd = [
 'ffmpeg', '-y', '-i', input_file,
 '-map', f'0:v:{idx}', '-c:v', 'copy', out_path
 ]
 subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
 if os.path.exists(out_path):
 out_files.append(out_path)
 return out_files

def apply_cover_art_to_output(input_file, output_file, temp_output=None):
 """Apply cover art from input_file to output_file. Optionally writes to temp_output and replaces output_file."""
 indices = get_attached_pic_indices(input_file)
 if not indices:
 return False
 # Build ffmpeg command to remux cover art into output file
 # Use a temp file to avoid overwriting in-place
 if temp_output is None:
 temp_output = output_file + '.withcover.tmp'
 map_args = []
 # Map all streams from output_file
 map_args.extend(['-i', output_file])
 # Map cover art from input_file
 map_args.extend(['-i', input_file])
 # Map all streams from output_file (except cover art)
 map_args.extend(['-map', '0'])
 # Map cover art streams from input_file
 for idx in indices:
 map_args.extend(['-map', f'1:v:{idx}'])
 # Set disposition for cover art
 for i, idx in enumerate(indices):
 map_args.extend(['-disposition:v:' + str(i+1), 'attached_pic'])
 cmd = [
 'ffmpeg', '-y'
 ] + map_args + [
 '-c', 'copy', temp_output
 ]
 subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
 # Replace output_file with temp_output if successful
 if os.path.exists(temp_output):
 shutil.move(temp_output, output_file)
 return True
 return False
