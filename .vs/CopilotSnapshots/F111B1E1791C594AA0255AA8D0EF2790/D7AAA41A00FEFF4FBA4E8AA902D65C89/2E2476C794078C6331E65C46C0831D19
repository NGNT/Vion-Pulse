import subprocess
from typing import Callable


def run_ffmpeg_process(command: list, output_callback: Callable[[str], None], should_stop_fn: Callable[[], bool]) -> int:
 """Run ffmpeg command, streaming stdout/stderr lines to output_callback.

 Args:
 command: list of command arguments
 output_callback: function called with each line of output
 should_stop_fn: callable that returns True when process should be stopped

 Returns:
 process return code (int)
 """
 proc = None
 try:
 output_callback(f"Runner: executing: {' '.join(command)}")
 proc = subprocess.Popen(
 command,
 stdout=subprocess.PIPE,
 stderr=subprocess.STDOUT,
 universal_newlines=True,
 creationflags=getattr(subprocess, 'CREATE_NO_WINDOW',0),
 bufsize=1,
 )

 # Read output lines
 while True:
 if should_stop_fn():
 try:
 proc.terminate()
 except Exception:
 pass
 break

 line = proc.stdout.readline()
 if line == '' and proc.poll() is not None:
 break
 if line:
 output_callback(line.rstrip())

 # Collect any remaining output
 try:
 remaining = proc.communicate()[0]
 if remaining:
 output_callback(remaining.strip())
 except Exception:
 pass

 return proc.returncode if proc is not None else -1
 except Exception as e:
 output_callback(f"FFmpeg runner error: {e}")
 try:
 if proc:
 proc.kill()
 except Exception:
 pass
 return -1
