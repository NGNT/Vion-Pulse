    def dropEvent(self, event):
        # Handle dropped files
        urls = event.mimeData().urls()
        if not urls:
            return
        # Only handle the first file
        file_path = urls[0].toLocalFile()
        if file_path and os.path.isfile(file_path):
            # Optionally: check for video file extensions
            video_exts = ['.mp4', '.mkv', '.avi', '.mov', '.webm', '.flv', '.wmv', '.m4v']
            if os.path.splitext(file_path)[1].lower() in video_exts:
                # Use the same unified flow as the file dialog
                self._load_input_file(file_path)
                self.log(f"Input file set by drag-and-drop: {file_path}")
            else:
                QMessageBox.warning(self, "Invalid File", "Please drop a supported video file.")
        else:
            QMessageBox.warning(self, "Invalid File", "Please drop a valid file.")
