QWidget {
    background-color: #f0f0f0; /* Light grey background */
    color: #000000;
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size: 15px;
}
QMainWindow {
    background-color: #f0f0f0;
}
QGroupBox {
    font-weight: bold;
    border: 1px solid #4a90e2; /* Blue outline */
    border-radius: 8px;
    margin-top: 1ex;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px 0 5px;
}
QTabWidget::pane {
    border: 1px solid #4a90e2; /* Blue outline */
}
QTabBar::tab {
    background-color: #e0e0e0;
    border: 1px solid #4a90e2;
    padding: 5px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:selected {
    background-color: #f0f0f0;
    border-bottom-color: #f0f0f0; /* Hide bottom border of selected tab */
}
QPushButton {
    background-color: #4a90e2;
    color: #fff;
    border: 1px solid #4a90e2;
    padding: 5px;
    border-radius: 6px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #d0d0d0;
    color: #000;
}
QPushButton:pressed {
    background-color: #c0c0c0;
}
QComboBox, QSpinBox, QLineEdit, QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #4a90e2;
    padding: 2px;
}
QProgressBar {
    border: 1px solid #4a90e2;
    text-align: center;
}
QProgressBar::chunk {
    background-color: #4a90e2;
    border-radius: 4px;
}
QCheckBox::indicator:checked {
    background-color: #4a90e2;
    border: 1px solid #4a90e2;
}
QCheckBox::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid #4a90e2;
    background-color: #ffffff;
}
QCheckBox::indicator:checked {
    background-color: #4a90e2;
}
/* Disabled states */
QPushButton:disabled, QComboBox:disabled, QSpinBox:disabled, QLineEdit:disabled {
    background-color: #e0e0e0;
    color: #888888;
    border-color: #c0c0c0;
}
QListWidget {
    background-color: #ffffff;
    border: 1px solid #4a90e2;
    border-radius: 4px;
    padding: 4px;
}
QListWidget::item:selected {
    background-color: #4a90e2;
    color: #fff;
    border-radius: 3px;
}
QListWidget::item:hover {
    background-color: #d0e6fa;
    color: #000;
}
QScrollBar:vertical, QScrollBar:horizontal {
    background: #e0e0e0;
    width: 12px;
    margin: 0px;
    border-radius: 6px;
}
QScrollBar::handle {
    background: #4a90e2;
    border-radius: 6px;
}
QMenuBar {
    background-color: #e0e0e0;
    color: #000;
}
QMenuBar::item:selected {
    background: #4a90e2;
    color: #fff;
}
QStatusBar {
    background: #e0e0e0;
    color: #000;
    border-top: 1px solid #4a90e2;
}
QTabBar::tab {
    background: #e0e0e0;
    color: #333;
    border: 1px solid #4a90e2;
    border-radius: 6px 6px 0 0;
    padding: 8px 16px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background: #4a90e2;
    color: #fff;
    border-bottom: 2px solid #4a90e2;
}}