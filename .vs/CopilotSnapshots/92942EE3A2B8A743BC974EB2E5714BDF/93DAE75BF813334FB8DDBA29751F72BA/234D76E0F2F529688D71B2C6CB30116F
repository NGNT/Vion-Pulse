from PyQt6.QtCore import QObject, pyqtSignal, pyqtSlot
import subprocess
import json
import os
import tempfile

class AudioAnalysisWorker(QObject):
    """
    Worker to run audio analysis (waveform and EBU R128 stats) in a background thread.
    """
    finished = pyqtSignal(dict)
    error = pyqtSignal(str)
    log = pyqtSignal(str)

    def __init__(self, input_file: str):
        super().__init__()
        self.input_file = input_file
        self._is_running = True

    def stop(self):
        self._is_running = False

    @pyqtSlot()
    def run(self):
        """
        Runs the audio analysis using ffmpeg.
        Generates a waveform image and gets EBU R128 stats.
        """
        if not self._is_running:
            return

        try:
            # 1. Generate waveform image
            waveform_path = os.path.join(tempfile.gettempdir(), f"waveform_{os.path.basename(self.input_file)}.png")
            waveform_cmd = [
                'ffmpeg', '-y', '-i', self.input_file,
                '-filter_complex', "[0:a]showwavespic=s=640x120:colors=white",
                '-frames:v', '1',
                waveform_path
            ]
            self.log("Generating waveform...")
            subprocess.run(waveform_cmd, check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, creationflags=getattr(subprocess, 'CREATE_NO_WINDOW', 0))
            self.log(f"Waveform image saved to {waveform_path}")

            if not self._is_running:
                return

            # 2. Get EBU R128 stats
            ebur128_cmd = [
                'ffmpeg', '-i', self.input_file,
                '-af', 'ebur128',
                '-f', 'null', '-'
            ]
            self.log("Analyzing EBU R128 loudness...")
            result = subprocess.run(ebur128_cmd, capture_output=True, text=True, creationflags=getattr(subprocess, 'CREATE_NO_WINDOW', 0))
            
            # Parse the stderr output for EBU R128 summary
            stats = self._parse_ebur128_output(result.stderr)
            self.log(f"EBU R128 analysis complete: {stats}")

            if self._is_running:
                self.finished.emit({
                    'waveform_path': waveform_path,
                    'ebur128_stats': stats
                })

        except subprocess.CalledProcessError as e:
            error_message = f"FFmpeg audio analysis failed: {e.stderr.decode('utf-8', errors='ignore')}"
            self.log(error_message)
            self.error.emit(error_message)
        except Exception as e:
            error_message = f"An error occurred during audio analysis: {e}"
            self.log(error_message)
            self.error.emit(error_message)

    def _parse_ebur128_output(self, stderr: str) -> dict:
        """
        Parses the stderr output from the ebur128 filter to extract summary stats.
        """
        stats = {}
        summary_started = False
        for line in stderr.splitlines():
            if "EBU R128" in line and "Summary" in line:
                summary_started = True
                continue
            
            if summary_started:
                if ":" in line:
                    parts = line.split(':')
                    key = parts[0].strip()
                    value = parts[1].strip()
                    
                    if "Integrated loudness" in key:
                        stats['integrated_loudness'] = value
                    elif "Loudness range" in key:
                        stats['loudness_range'] = value
                    elif "True peak" in key:
                        stats['true_peak'] = value
        return stats
