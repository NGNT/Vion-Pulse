"""
Video Preview Worker - Generates thumbnail snapshots from video files

This worker creates a series of thumbnail images from different sections of a video
to provide users with a visual preview of the content before conversion.
"""

import os
import subprocess
import tempfile
import json
from typing import List, Tuple, Optional
from PyQt6.QtCore import QObject, pyqtSignal, QThread, Qt
from PyQt6.QtGui import QPixmap
from PyQt6.QtWidgets import QLabel


class VideoPreviewWorker(QObject):
    """Worker class for generating video preview thumbnails in a separate thread."""
    
    # Signals
    preview_ready = pyqtSignal(list)  # Emits list of QPixmap objects
    progress_updated = pyqtSignal(int)  # Progress percentage (0-100)
    error_occurred = pyqtSignal(str)  # Error message
    log_message = pyqtSignal(str)  # Log messages
    finished = pyqtSignal()  # Worker completed
    
    def __init__(self, video_path: str, thumbnail_count: int = 1, 
                 thumbnail_size: Tuple[int, int] = (320, 240), output_settings: dict = None):
        """
        Initialize the video preview worker.
        
        Args:
            video_path: Path to the video file
            thumbnail_count: Number of thumbnails to generate (default: 1 for output preview)
            thumbnail_size: Size of thumbnails as (width, height) tuple (default: 320x240)
            output_settings: Settings to apply for output preview (default: None)
        """
        super().__init__()
        self.video_path = video_path
        self.thumbnail_count = thumbnail_count  # Will be 1 for output preview
        self.thumbnail_size = thumbnail_size
        self.output_settings = output_settings or {}  # Settings to apply for output preview
        self.temp_dir = None
        self._should_stop = False
        
    def stop(self):
        """Stop the preview generation process."""
        self._should_stop = True
    
    def run(self):
        """Main execution method - generates video previews."""
        try:
            self.log_message.emit(f"Generating output preview for: {os.path.basename(self.video_path)}")
            
            # Validate input file
            if not os.path.exists(self.video_path):
                self.error_occurred.emit(f"Video file not found: {self.video_path}")
                return
            
            # Get video duration first
            duration = self._get_video_duration()
            if duration <= 0:
                self.error_occurred.emit("Could not determine video duration")
                return
            
            self.log_message.emit(f"Video duration: {duration:.2f} seconds")
            
            # Create temporary directory for thumbnails
            self.temp_dir = tempfile.mkdtemp(prefix="video_preview_")
            
            # Generate single output preview at 25% through the video
            thumbnails = []
            timestamp = duration * 0.25  # 25% through the video
            
            self.log_message.emit(f"Generating output preview at {timestamp:.2f}s")
            
            # Generate thumbnail with output settings applied
            thumbnail_path = self._generate_output_thumbnail(timestamp)
            if thumbnail_path and os.path.exists(thumbnail_path):
                # Load as QPixmap
                pixmap = QPixmap(thumbnail_path)
                if not pixmap.isNull():
                    thumbnails.append(pixmap)
                    self.log_message.emit("Output preview generated successfully")
                else:
                    self.log_message.emit("Failed to load output preview")
            else:
                self.log_message.emit("Failed to generate output preview")
            
            # Update progress
            self.progress_updated.emit(100)
            
            self.preview_ready.emit(thumbnails)
        
        except Exception as e:
            self.error_occurred.emit(f"Error generating output preview: {str(e)}")
        
        finally:
            # Cleanup temporary files
            self._cleanup_temp_files()
            self.finished.emit()
    
    def _get_video_duration(self) -> float:
        """Get the duration of the video file using ffprobe."""
        try:
            cmd = [
                'ffprobe', '-v', 'quiet',
                '-show_entries', 'format=duration',
                '-of', 'json',
                self.video_path
            ]
            
            result = subprocess.run(
                cmd, 
                stdout=subprocess.PIPE, 
                stderr=subprocess.PIPE, 
                text=True,
                creationflags=getattr(subprocess, 'CREATE_NO_WINDOW', 0)
            )
            
            if result.returncode == 0:
                data = json.loads(result.stdout)
                duration = float(data.get('format', {}).get('duration', 0))
                return duration
            else:
                self.log_message.emit(f"ffprobe error: {result.stderr}")
                return 0.0
        
        except Exception as e:
            self.log_message.emit(f"Error getting video duration: {str(e)}")
            return 0.0
    
    def _generate_thumbnail(self, timestamp: float, index: int) -> Optional[str]:
        """Generate a single thumbnail at the specified timestamp."""
        try:
            output_path = os.path.join(self.temp_dir, f"thumb_{index:03d}.jpg")
            
            cmd = [
                'ffmpeg', '-y',  # Overwrite output files
                '-ss', str(timestamp),  # Seek to timestamp
                '-i', self.video_path,  # Input file
                '-vframes', '1',  # Extract only 1 frame
                '-q:v', '2',  # High quality JPEG
                '-vf', f'scale={self.thumbnail_size[0]}:{self.thumbnail_size[1]}:force_original_aspect_ratio=decrease,pad={self.thumbnail_size[0]}:{self.thumbnail_size[1]}:(ow-iw)/2:(oh-ih)/2',
                '-v', 'quiet',  # Suppress verbose output
                output_path
            ]
            
            result = subprocess.run(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                creationflags=getattr(subprocess, 'CREATE_NO_WINDOW', 0)
            )
            
            if result.returncode == 0 and os.path.exists(output_path):
                return output_path
            else:
                self.log_message.emit(f"FFmpeg error for thumbnail {index}: {result.stderr.decode() if result.stderr else 'Unknown error'}")
                return None
        
        except Exception as e:
            self.log_message.emit(f"Error generating thumbnail {index}: {str(e)}")
            return None

    def _generate_output_thumbnail(self, timestamp: float) -> Optional[str]:
        """Generate a thumbnail that simulates the output video with applied settings."""
        try:
            output_path = os.path.join(self.temp_dir, "output_preview.jpg")
            
            # Build FFmpeg command with output settings applied
            cmd = ['ffmpeg', '-y', '-ss', str(timestamp), '-i', self.video_path, '-vframes', '1']
            
            # Apply video filters based on output settings
            vf_filters = []
            
            # Resolution scaling
            resolution = self.output_settings.get('resolution', 'Original')
            if resolution != 'Original':
                res_map = {'4K (2160p)': 2160, '1440p': 1440, '1080p': 1080, '720p': 720, '480p': 480}
                if resolution in res_map:
                    target_h = res_map[resolution]
                    vf_filters.append(f'scale=-2:{target_h}')
            
            # Deinterlacing
            if self.output_settings.get('deinterlace', False):
                vf_filters.append('bwdif=0:-1:0')
            
            # Apply thumbnail sizing
            vf_filters.append(f'scale={self.thumbnail_size[0]}:{self.thumbnail_size[1]}:force_original_aspect_ratio=decrease,pad={self.thumbnail_size[0]}:{self.thumbnail_size[1]}:(ow-iw)/2:(oh-ih)/2')
            
            if vf_filters:
                cmd.extend(['-vf', ','.join(vf_filters)])
            
            cmd.extend(['-q:v', '2', '-v', 'quiet', output_path])
            
            result = subprocess.run(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                creationflags=getattr(subprocess, 'CREATE_NO_WINDOW', 0)
            )
            
            if result.returncode == 0 and os.path.exists(output_path):
                return output_path
            else:
                self.log_message.emit(f"FFmpeg error for output preview: {result.stderr.decode() if result.stderr else 'Unknown error'}")
                return None
        
        except Exception as e:
            self.log_message.emit(f"Error generating output preview: {str(e)}")
            return None
    
    def _cleanup_temp_files(self):
        """Clean up temporary thumbnail files."""
        if self.temp_dir and os.path.exists(self.temp_dir):
            try:
                import shutil
                shutil.rmtree(self.temp_dir)
                self.log_message.emit("Cleaned up temporary files")
            except Exception as e:
                self.log_message.emit(f"Error cleaning up temp files: {str(e)}")


class VideoPreviewWidget(QLabel):
    """
    Widget for displaying a single video thumbnail with timestamp info.
    """
    
    def __init__(self, pixmap: QPixmap = None, timestamp: float = 0.0):
        super().__init__()
        self.timestamp = timestamp
        
        # Set up the label for larger preview
        self.setFixedSize(400, 300)  # Larger size for output preview
        self.setStyleSheet("""
            QLabel {
                border: 2px solid #4682b4;
                background-color: #ffffff;
                margin: 5px;
            }
        """)
        self.setScaledContents(True)
        
        if pixmap:
            self.setPixmap(pixmap)
        else:
            # Placeholder text
            self.setText("Generating output preview...\n\nThis will show how your converted video will look.")
            self.setAlignment(Qt.AlignmentFlag.AlignCenter)
    
    def set_thumbnail(self, pixmap: QPixmap, timestamp: float):
        """Set the thumbnail image and timestamp."""
        self.setPixmap(pixmap)
        self.timestamp = timestamp
        
        # Set tooltip with timestamp
        minutes = int(timestamp // 60)
        seconds = int(timestamp % 60)
        self.setToolTip(f"Preview from {minutes:02d}:{seconds:02d} into the video\n\nThis shows how your output will look with current settings.")


class VideoPreviewManager:
    """
    Manager class for handling video preview generation with threading.
    """
    
    def __init__(self, log_callback=None):
        """
        Initialize the preview manager.
        
        Args:
            log_callback: Optional callback function for log messages
        """
        self.log_callback = log_callback
        self._worker = None
        self._thread = None
        self._preview_widgets = []
    
    def generate_preview(self, video_path: str, thumbnail_count: int = 1, 
                         thumbnail_size: Tuple[int, int] = (320, 240), output_settings: dict = None) -> List[VideoPreviewWidget]:
        """
        Generate video preview thumbnails.
        
        Args:
            video_path: Path to video file
            thumbnail_count: Number of thumbnails to generate (default: 1 for output preview)
            thumbnail_size: Size of thumbnails (default: 320x240 for single preview)
            output_settings: Dictionary of output settings to apply for preview
        
        Returns:
            List of VideoPreviewWidget objects (initially empty, populated via signals)
        """
        # Stop any existing preview generation
        self.stop_preview()
        
        # Create placeholder widgets
        self._preview_widgets = []
        for i in range(thumbnail_count):
            widget = VideoPreviewWidget()
            self._preview_widgets.append(widget)
        
        # Start worker in thread
        self._thread = QThread()
        self._worker = VideoPreviewWorker(video_path, thumbnail_count, thumbnail_size, output_settings)
        self._worker.moveToThread(self._thread)
        
        # Connect signals
        self._worker.preview_ready.connect(self._on_preview_ready)
        self._worker.error_occurred.connect(self._on_error)
        self._worker.log_message.connect(self._on_log)
        self._worker.finished.connect(self._cleanup_worker)
        
        # Start the worker
        self._thread.started.connect(self._worker.run)
        self._thread.start()
        
        return self._preview_widgets
    
    def stop_preview(self):
        """Stop current preview generation."""
        if self._worker:
            self._worker.stop()
        
        if self._thread and self._thread.isRunning():
            self._thread.quit()
            self._thread.wait(3000)  # Wait up to 3 seconds
    
    def _on_preview_ready(self, thumbnails: List[QPixmap]):
        """Handle preview thumbnails ready."""
        for i, (widget, pixmap) in enumerate(zip(self._preview_widgets, thumbnails)):
            if i < len(thumbnails):
                # Calculate timestamp for display
                # This is approximate - in a real implementation you'd store actual timestamps
                widget.set_thumbnail(pixmap, i * 30)  # Rough estimate
    
    def _on_error(self, error_msg: str):
        """Handle preview generation error."""
        if self.log_callback:
            self.log_callback(f"Preview error: {error_msg}")
        
        # Update widgets to show error
        for widget in self._preview_widgets:
            widget.setText("Error")
    
    def _on_log(self, message: str):
        """Handle log messages."""
        if self.log_callback:
            self.log_callback(message)
    
    def _cleanup_worker(self):
        """Clean up worker and thread."""
        try:
            if self._thread:
                self._thread.quit()
                self._thread.wait(1000)
        except Exception:
            pass
        finally:
            self._worker = None
            self._thread = None


