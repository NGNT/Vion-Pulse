import QtQuick

Item {
 id: root
 width:360
 height:90

 // Theme-driven properties
 property url sourcePath: ""
 property color color1: "#52FFF5"
 property color color2: "#E6B35C"

 // Base image used as alpha mask
 Image {
 id: base
 anchors.fill: parent
 source: root.sourcePath
 fillMode: Image.PreserveAspectFit
 visible: false // hidden; used as texture source for the shader
 smooth: true
 mipmap: true
 }

 // Shader recolors the logo using a left->right gradient and the base alpha
 ShaderEffect {
 anchors.fill: parent
 property var source: base
 property color color1: root.color1
 property color color2: root.color2
 fragmentShader: "\
 uniform sampler2D source;\n\
 uniform lowp float qt_Opacity;\n\
 uniform lowp vec4 color1;\n\
 uniform lowp vec4 color2;\n\
 varying highp vec2 qt_TexCoord0;\n\
 void main() {\n\
 lowp vec4 src = texture2D(source, qt_TexCoord0);\n\
 lowp float a = src.a;\n\
 lowp vec4 grad = mix(color1, color2, qt_TexCoord0.x);\n\
 gl_FragColor = vec4(grad.rgb, a) * qt_Opacity;\n\
 }\n"
 }
}
