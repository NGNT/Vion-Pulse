from PyQt6.QtCore import QObject, pyqtSignal, pyqtSlot
import subprocess
import os
import tempfile
import re

class AudioAnalysisWorker(QObject):
    """
    Worker to run audio analysis (waveform and EBU R128 stats) in a background thread.
    """
    finished = pyqtSignal(dict)
    error = pyqtSignal(str)
    log = pyqtSignal(str)
    progress = pyqtSignal(int) #0-100

    def __init__(self, input_file: str):
        super().__init__()
        self.input_file = input_file
        self._is_running = True
        self.process = None
        self._duration_seconds = None

    def _probe_duration_seconds(self):
        try:
            # Fast duration probe in seconds (float)
            cmd = [
                'ffprobe','-v','error','-show_entries','format=duration',
                '-of','default=nw=1:nk=1', self.input_file
            ]
            res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, creationflags=getattr(subprocess, 'CREATE_NO_WINDOW',0))
            if res.returncode ==0:
                val = (res.stdout or '').strip()
                self._duration_seconds = float(val) if val else None
        except Exception:
            self._duration_seconds = None

    def stop(self):
        self._is_running = False
        if self.process:
            try:
                self.process.terminate()
                self.process.wait(timeout=5)
            except Exception as e:
                self.log.emit(f"Error terminating audio analysis process: {e}")

    @pyqtSlot()
    def run(self):
        """
        Runs the audio analysis using ffmpeg.
        Generates a waveform image and gets EBU R128 stats.
        """
        if not self._is_running:
            return

        try:
            # Probe duration for progress calculations
            self._probe_duration_seconds()
            if self._duration_seconds and self._duration_seconds >0:
                # Initialize progress to0
                self.progress.emit(0)

            #1. Generate waveform image
            waveform_path = os.path.join(tempfile.gettempdir(), f"waveform_{os.path.basename(self.input_file)}.png")
            waveform_cmd = [
                'ffmpeg', '-y', '-i', self.input_file,
                '-filter_complex', "[0:a]showwavespic=s=640x120:colors=white",
                '-frames:v', '1',
                waveform_path
            ]
            self.log.emit("Generating waveform...")
            self.process = subprocess.Popen(waveform_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, creationflags=getattr(subprocess, 'CREATE_NO_WINDOW',0))
            _, stderr = self.process.communicate()
            if self.process.returncode !=0:
                raise subprocess.CalledProcessError(self.process.returncode, waveform_cmd, stderr=stderr)
            self.log.emit(f"Waveform image saved to {waveform_path}")

            if not self._is_running:
                return

            #2. Get EBU R128 stats with progress
            ebur128_cmd = [
                'ffmpeg', '-hide_banner', '-nostats', '-i', self.input_file,
                '-af', 'ebur128',
                '-f', 'null', '-',
                '-progress', 'pipe:1'
            ]
            self.log.emit("Analyzing EBU R128 loudness...")
            self.process = subprocess.Popen(
                ebur128_cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                creationflags=getattr(subprocess, 'CREATE_NO_WINDOW',0),
                encoding='utf-8',
                errors='replace'
            )

            full_output = []
            # Real-time processing of ffmpeg output
            for line in iter(self.process.stdout.readline, ''):
                if not self._is_running:
                    try:
                        self.process.terminate()
                    except Exception:
                        pass
                    break
                full_output.append(line)

                # Parse progress out_time_ms if duration known
                if self._duration_seconds and self._duration_seconds >0:
                    if line.startswith('out_time_ms='):
                        try:
                            processed_us = int(line.split('=',1)[1].strip())
                            percent = int(min(100, max(0, (processed_us / (self._duration_seconds *1_000_000)) *100)))
                            self.progress.emit(percent)
                        except Exception:
                            pass

            self.process.wait()

            # Emit100% if completed normally
            if self._is_running and self._duration_seconds and self._duration_seconds >0:
                self.progress.emit(100)
            
            # Parse the stderr/stdout output for EBU R128 summary
            stats = self._parse_ebur128_output("".join(full_output))
            self.log.emit(f"EBU R128 analysis complete: {stats}")

            if self._is_running:
                self.finished.emit({
                    'waveform_path': waveform_path,
                    'ebur128_stats': stats
                })

        except subprocess.CalledProcessError as e:
            error_message = f"FFmpeg audio analysis failed: {e.stderr}"
            self.log.emit(error_message)
            self.error.emit(error_message)
        except Exception as e:
            error_message = f"An error occurred during audio analysis: {e}"
            self.log.emit(error_message)
            self.error.emit(error_message)
        finally:
            self.process = None

    def _parse_ebur128_output(self, text: str) -> dict:
        """
        Parses the ffmpeg ebur128 output to extract summary stats.
        Handles common variants across ffmpeg versions.
        """
        stats = {}
        try:
            lines = [ln.strip() for ln in text.splitlines() if ln.strip()]
            # Find a summary block if present
            summary_idx = -1
            for i, ln in enumerate(lines):
                # Typical line contains 'Summary:' or 'summary'
                if 'summary' in ln.lower():
                    summary_idx = i
                    break
            search_range = lines
            if summary_idx != -1:
                # Look at the next ~12 lines for key metrics
                search_range = lines[summary_idx: summary_idx +20]

            # Regexes for metrics (shorthand and long labels)
            m_i = None
            m_lra = None
            m_peak = None
            re_i_short = re.compile(r"\bI:\s*([\-0-9.]+)\s*LUFS", re.IGNORECASE)
            re_i_long = re.compile(r"Integrated\s+loudness:\s*([\-0-9.]+)\s*LUFS", re.IGNORECASE)
            re_lra_short = re.compile(r"\bLRA:\s*([\-0-9.]+)\s*LU\b", re.IGNORECASE)
            re_lra_long = re.compile(r"Loudness\s+range:\s*([\-0-9.]+)\s*LU\b", re.IGNORECASE)
            re_peak = re.compile(r"\b(True\s+)?Peak:\s*([\-0-9.]+)\s*dB(TP|FS)?", re.IGNORECASE)

            def scan(container):
                nonlocal m_i, m_lra, m_peak
                for ln in container:
                    if m_i is None:
                        mi = (re_i_short.search(ln) or re_i_long.search(ln))
                        if mi:
                            # Pick group1 from whichever matched
                            m_i = mi.group(1)
                    if m_lra is None:
                        ml = (re_lra_short.search(ln) or re_lra_long.search(ln))
                        if ml:
                            m_lra = ml.group(1)
                    if m_peak is None:
                        mp = re_peak.search(ln)
                        if mp:
                            m_peak = mp.group(2)
                    if m_i and m_lra and m_peak:
                        return True
                return False

            # First, try summary block
            found = scan(search_range)
            # Fallback: scan whole output
            if not found:
                scan(lines)

            if m_i is not None:
                stats['integrated_loudness'] = f"{m_i} LUFS"
            if m_lra is not None:
                stats['loudness_range'] = f"{m_lra} LU"
            if m_peak is not None:
                stats['true_peak'] = f"{m_peak} dBTP"
        except Exception as e:
            self.log.emit(f"Could not parse EBU R128 output: {e}")
        return stats
