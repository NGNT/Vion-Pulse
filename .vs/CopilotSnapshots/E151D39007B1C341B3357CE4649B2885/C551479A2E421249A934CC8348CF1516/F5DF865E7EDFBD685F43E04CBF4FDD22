QWidget {
    background-color: @bg; /* app background */
    color: @text; /* primary text */
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size:12px;
}
QMainWindow {
    background-color: @bg;
}
QGroupBox {
    font-weight: bold;
    border:1px solid @border; /* group outline */
    border-radius:8px;
    /* give enough room for the title to render fully above the frame */
    margin-top:1.2em;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left:10px;

    /* top right bottom left */
    padding:06px2px6px;
    color: @border;
    font-size:11px;
    font-weight: bold;
}
QTabWidget::pane {
    border:1px solid @border; /* tab outline */
}
QTabBar::tab {
    background-color: @tab_bg;
    color: @text;
    border:1px solid @border;
    border-top-left-radius:6px;
    border-top-right-radius:6px;
    padding:4px8px;
    margin-right:2px;
}
QTabBar::tab:selected {
    background-color: @tab_selected_bg;
    border:1px solid @accent;
    color: @accent;
}
QPushButton {
    background-color: @button_bg;
    color: @button_text;
    border:1px solid @button_border;
    border-radius:6px;
    padding:5px10px;
}
QPushButton:hover {
    border:1px solid @accent;
    color: @accent;
    background-color: @surface_hover;
}
QPushButton:pressed {
    background-color: @surface_alt;
    border:1px solid @accent;
}
QComboBox, QSpinBox, QLineEdit, QPlainTextEdit {
    background-color: @input_bg;
    color: @input_text;
    border:1px solid @input_border;
    border-radius:4px;
    selection-background-color: @selection_bg;
}
QLineEdit:focus, QComboBox:focus, QTextEdit:focus {
    border:1px solid @accent;
    background-color: @focus_bg;
}
QProgressBar {
    border:1px solid @border;
    border-radius:6px;
    background-color: @progress_bg;
    text-align: center;
    color: @text;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 @chunk_start, stop:0.5 @chunk_mid, stop:1 @chunk_end);
    border-radius:5px;
}
QCheckBox::indicator {
    width:13px;
    height:13px;
    border:1px solid @checkbox_border;
    background-color: @checkbox_bg;
}
QCheckBox::indicator:checked {
    background-color: @checkbox_checked_bg;
    border:1px solid @checkbox_checked_bg;
}
/* Disabled states */
QPushButton:disabled, QComboBox:disabled, QSpinBox:disabled, QLineEdit:disabled {
    background-color: @disabled_bg;
    color: @disabled_text;
    border-color: @disabled_border;
}
QListWidget {
    background-color: @list_bg;
    border:1px solid @border;
    border-radius:4px;
    padding:4px;
    color: @text;
}
QListWidget::item:selected {
    background-color: @list_selected_bg;
    color: @list_selected_text;
    border-radius:3px;
}
QListWidget::item:hover {
    background-color: @list_hover_bg;
    color: @list_hover_text;
}
QScrollBar:vertical, QScrollBar:horizontal {
    background: @scroll_bg;
    border:1px solid @border;
    border-radius:4px;
}
QScrollBar::handle {
    background: @scroll_handle_bg;
    border-radius:4px;
}
QScrollBar::handle:hover {
    background: @scroll_handle_hover;
}
QMenuBar {
    background-color: @menu_bg;
    color: @menu_text;
}
QMenuBar::item:selected {
    background: @menu_selected_bg;
    color: @menu_selected_text;
}
QStatusBar {
    background: @status_bg;
    color: @status_text;
    border-top:1px solid @status_border_top;
}