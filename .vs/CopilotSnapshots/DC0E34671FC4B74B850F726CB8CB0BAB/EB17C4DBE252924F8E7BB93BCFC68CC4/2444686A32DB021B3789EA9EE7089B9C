                self.output_label.setText(os.path.basename(self.output_file))
                self.log(f"Input file selected: {self.input_file}")
                self.log(f"Default output file: {self.output_file}")
                self.populate_stream_info()

    def select_output(self):
        file_dialog = QtWidgets.QFileDialog(self, "Select Output File", "", "MP4 files (*.mp4);;MKV files (*.mkv);;MOV files (*.mov);;All files (*)")
        file_dialog.setAcceptMode(QtWidgets.QFileDialog.AcceptMode.AcceptSave)
        file_dialog.setDefaultSuffix("mp4")
