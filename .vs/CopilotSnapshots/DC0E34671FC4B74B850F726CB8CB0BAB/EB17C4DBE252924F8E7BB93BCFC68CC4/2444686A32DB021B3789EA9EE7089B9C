            files = file_dialog.selectedFiles()
            if files:
                self.output_file = files[0]
                self.output_label.setText(os.path.basename(self.output_file))
                self.log(f"Output file selected: {self.output_file}")

    def populate_stream_info(self):
        if not self.input_file:
            return
        
        self._input_duration = self.get_video_duration(self.input_file)
        self._audio_meta = self.get_audio_streams(self.input_file)
        self._subtitle_meta = self.get_subtitle_streams(self.input_file)

        audio_options = [f"Stream #{s['index']} ({s.get('tags', {}).get('language', 'und')}) - {s.get('codec_name', 'N/A')}" for s in self._audio_streams]
        self.audio_stream_combo.addItems(audio_options)
        if audio_options:
            self.audio_stream_combo.setCurrentText(audio_options[0])

        subtitle_options = ["None"] + [f"Stream #{s['index']} ({s.get('tags', {}).get('language', 'und')}) - {s.get('codec_name', 'N/A')}" for s in self._subtitle_streams]
        self.subtitle_stream_combo.addItems(subtitle_options)
        self.subtitle_stream_combo.setCurrentText("None")

    def update_quality_controls(self, event=None):
        mode = self.quality_mode_var.get()
        if mode == 'Constant Quality (CRF)':
            self.crf_label.setEnabled(True)
            self.crf.setEnabled(True)
            self.bitrate_label.setEnabled(False)
            self.adv_bitrate.setEnabled(False)
        else:
            self.crf_label.setEnabled(False)
            self.crf.setEnabled(False)
            self.bitrate_label.setEnabled(True)
            self.adv_bitrate.setEnabled(True)

    def build_ffmpeg_command(self):
        if not self.input_file:
            raise ValueError('No input file specified.')
        if not self.output_file:
            raise ValueError('No output file specified.')

        cmd = ['ffmpeg', '-y', '-i', self.input_file, '-map', '0:v:0']

        # Video codec
        if self.hw_enabled_var.get():
            enc = self.hw_encoder_var.get()
            if 'NVIDIA' in enc:
                cmd += ['-c:v', 'h264_nvenc']
            elif 'Intel' in enc:
                cmd += ['-c:v', 'h264_qsv']
            elif 'VAAPI' in enc:
                cmd += ['-c:v', 'h264_vaapi']
        else:
            cmd += ['-c:v', 'libx264']

        # Quality settings
        if self.quality_mode_var.get() == 'Constant Quality (CRF)':
            if self.hw_enabled_var.get():
                enc = self.hw_encoder_var.get()
                val = str(self.crf_var.get())
                if 'NVIDIA' in enc:
                    cmd += ['-cq', val]
                elif 'Intel' in enc:
                    cmd += ['-global_quality', val]
                elif 'VAAPI' in enc:
                    cmd += ['-qp', val]
            else:
                cmd += ['-crf', str(self.crf_var.get())]
        else:
            cmd += ['-b:v', f"{self.bitrate_var.get()}k"]

        # Framerate
        if self.framerate_mode_var.get() == 'Constant' and self.framerate_var.get() != 'Original':
            cmd += ['-r', self.framerate_var.get()]

        # Audio simple default
        cmd += ['-c:a', self.audio_codec_var.get()]

        # Container flags
        cmd += ['-map_metadata', '0']
        if self.output_file.lower().endswith('.mp4'):
            cmd += ['-movflags', '+faststart']

        extra = self.extra_params.get().strip()
        if extra:
            cmd += extra.split()

        cmd.append(self.output_file)
        self.log("=== FFMPEG COMMAND ===\n" + ' '.join(cmd) + '\n')
        return cmd

    def start_conversion(self):
        """Start the video conversion process"""
        try:
            subprocess.run(['ffmpeg', '-version'], stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True, creationflags=getattr(subprocess, 'CREATE_NO_WINDOW', 0))
        except (FileNotFoundError, subprocess.CalledProcessError):
            QtWidgets.QMessageBox.critical(self, "FFmpeg Not Found", "FFmpeg is not installed or not in your system's PATH.")
            return

        if not self.input_file:
            QtWidgets.QMessageBox.warning(self, "Error", "Please select an input file.")
            return
        if not self.output_file:
            QtWidgets.QMessageBox.warning(self, "Error", "Please select an output file.")
            return

        out_dir = os.path.dirname(self.output_file)
        if out_dir and not os.path.exists(out_dir):
            os.makedirs(out_dir, exist_ok=True)
        if out_dir and not os.access(out_dir, os.W_OK):
            QtWidgets.QMessageBox.critical(self, "Permission Denied", f"Cannot write to: {out_dir}")
            return

        try:
            cmd = self.build_ffmpeg_command()
        except Exception as e:
            QtWidgets.QMessageBox.critical(self, "Error Building Command", f"Failed to prepare conversion command:\n{e}")
            self.log(f"Error building command: {e}")
            return

        self.progress_bar.setValue(0)
        self.progress_label.setText("Starting conversion...")
        self.start_btn.setDisabled(True)
        self.cancel_btn.setDisabled(False)
        
        self._input_duration = self.get_video_duration(self.input_file)
        
        self.conversion_thread = ConversionThread(
            cmd, 
            callback=self.conversion_finished,
            output_callback=self.handle_ffmpeg_output
        )
        self.conversion_thread.start()
        self.log("Conversion started...")

    def handle_ffmpeg_output(self, output):
        """Handle FFmpeg output for progress tracking"""
        self.log(output.strip())
        
        if self._input_duration == 0:
            duration_match = re.search(r"Duration: (\d{2}):(\d{2}):(\d{2})\.\d{2}", output)
            if duration_match:
                h, m, s = map(int, duration_match.groups())
                self._input_duration = h * 3600 + m * 60 + s

        progress_match = PROGRESS_RE.search(output)
        if progress_match:
            time_str = progress_match.group('time')
            h, m, s_float = map(float, time_str.split(':'))
            current_seconds = h * 3600 + m * 60 + s_float
            if self._input_duration > 0:
                progress = min((current_seconds / self._input_duration) * 100, 99)
                self.update_progress(progress, current_seconds)

    def update_progress(self, progress, current_seconds):
        """Update progress bar and label"""
        self.progress_bar.setValue(progress)
        minutes, seconds = divmod(int(current_seconds), 60)
        hours, minutes = divmod(minutes, 60)
        time_str = f"{hours:02d}:{minutes:02d}:{seconds:02d}"
        self.progress_label.setText(f"Processing... {time_str} ({progress:.1f}%)")

    def get_video_duration(self, file_path):
        """Get video duration in seconds using FFprobe"""
        try:
            cmd = ['ffprobe', '-v', 'error', '-show_entries', 'format=duration', 
                   '-of', 'default=noprint_wrappers=1:nokey=1', file_path]
            result = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                                  creationflags=getattr(subprocess, 'CREATE_NO_WINDOW', 0))
            if result.returncode == 0 and result.stdout.strip():
                return float(result.stdout.strip())
        except Exception as e:
            self.log(f"Error getting video duration: {e}")
        return 0

    def get_subtitle_streams(self, file_path):
        """Get subtitle streams from a video file using ffprobe"""
        try:
            cmd = ['ffprobe', '-v', 'error', '-select_streams', 's', '-show_entries', 'stream=index,codec_name:stream_tags=language', '-of', 'json', file_path]
            result = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                                  creationflags=getattr(subprocess, 'CREATE_NO_WINDOW', 0))
            data = json.loads(result.stdout)
            return data.get('streams', [])
        except Exception as e:
            self.log(f"Error getting subtitle streams: {e}")
        return []

    def get_audio_streams(self, file_path):
        """Get audio streams with order position and language"""
        try:
            cmd = ['ffprobe', '-v', 'error', '-select_streams', 'a', '-show_entries', 'stream=index,codec_name,tags=language', '-of', 'json', file_path]
            result = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                                  creationflags=getattr(subprocess, 'CREATE_NO_WINDOW', 0))
            data = json.loads(result.stdout or '{}')
            return data.get('streams', [])
        except Exception as e:
            self.log(f"Error getting audio streams: {e}")
        return []

    def conversion_finished(self, success, error_msg):
        """Handle conversion completion"""
        def update_ui():
            self.start_btn.setDisabled(False)
            self.cancel_btn.setDisabled(True)
            
            if success and os.path.exists(self.output_file):
                output_size = os.path.getsize(self.output_file)
                if output_size > 0:
                    self.progress_bar.setValue(100)
                    self.progress_label.setText("Conversion completed successfully!")
                    size_mb = output_size / (1024 * 1024)
                    QtWidgets.QMessageBox.information(self, "Success", 
                                        f"Video conversion completed successfully!\n\n"
                                        f"Output file: {self.output_file}\n"
                                        f"Size: {size_mb:.2f} MB")
                    self.log(f"Conversion completed. Output size: {size_mb:.2f} MB")
                    return
            
            self.progress_bar.setValue(0)
            self.progress_label.setText("Conversion failed")
            self.log(f"Conversion failed: {error_msg}")
            
            if os.path.exists(self.output_file):
                try:
                    os.remove(self.output_file)
                    self.log("Partial output file removed.")
                except Exception as e:
                    self.log(f"Failed to remove partial output file: {e}")
            
            QtWidgets.QMessageBox.critical(self, "Error", f"Conversion failed!\n\n{error_msg}")
      
        self.timer = QtCore.QTimer()
        self.timer.setSingleShot(True)
        self.timer.timeout.connect(update_ui)
        self.timer.start(100)

    def cancel_conversion(self):
        """Cancel the ongoing conversion"""
        if self.conversion_thread and self.conversion_thread.is_alive():
            self.conversion_thread.stop()
            self.log("Conversion canceled.")
            self.progress_bar.setValue(0)
            self.progress_label.setText("Conversion canceled")
            self.start_btn.setDisabled(False)
            self.cancel_btn.setDisabled(True)

    def closeEvent(self, event):
        """Handle window close event"""
        if self.conversion_thread and self.conversion_thread.is_alive():
            self.conversion_thread.stop()
        event.accept()

