from threading import Thread

# Regex to parse FFmpeg's progress output
PROGRESS_RE = re.compile(
    r"frame=\s*(?P<frame>\d+)\s+fps=\s*(?P<fps>[\d.]+)\s+q=(?P<q>[-0-9.]+)\s+L?size=\s*(?P<size>\S+)\s+time=(?P<time>\d{2}:\d{2}:\d{2}\.\d{2})\s+bitrate=\s*(?P<bitrate>[\d.]+\w?bits/s)\s+speed=\s*(?P<speed>\d+\.?\d*)x"
)

class ConversionThread(Thread):
    def __init__(self, cmd, callback=None, output_callback=None):
        super().__init__()
        self.cmd = cmd
        self.callback = callback
        self.output_callback = output_callback
        self._running = True
        self.daemon = True
        self.process = None

    def run(self):
        try:
            creationflags = 0
            if sys.platform == "win32":
                creationflags = subprocess.CREATE_NO_WINDOW

            self.process = subprocess.Popen(
                self.cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                universal_newlines=True,
                encoding='utf-8',
                creationflags=creationflags
            )

            for line in iter(self.process.stdout.readline, ''):
                if not self._running:
                    self.process.terminate()
                    break
                if self.output_callback:
                    self.output_callback(line)
            
            self.process.stdout.close()
            return_code = self.process.wait()

            if self.callback:
                self.callback(return_code == 0, '' if return_code == 0 else 'FFmpeg process terminated.')
        except Exception as e:
            if self.callback:
                self.callback(False, str(e))

    def stop(self):
        self._running = False
        if self.process:
            self.process.terminate()

