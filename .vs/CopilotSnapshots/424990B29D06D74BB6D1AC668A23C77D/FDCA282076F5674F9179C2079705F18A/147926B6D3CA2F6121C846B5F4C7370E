from PyQt6.QtWidgets import (QWidget, QVBoxLayout, QGridLayout, QGroupBox, QLabel, QComboBox, QSlider, QCheckBox, QHBoxLayout)
from PyQt6.QtCore import Qt

class AudioSettingsWidget(QWidget):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setup_ui()

    def setup_ui(self):
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)

        audio_group = QGroupBox("Audio Settings")
        grid = QGridLayout()

        # Audio codec
        grid.addWidget(QLabel("Audio Codec:"), 0, 0)
        self.audio_codec = QComboBox()
        self.audio_codec.addItems(["AAC", "MP3", "Opus", "Vorbis", "Copy Original"])
        grid.addWidget(self.audio_codec, 0, 1)

        # Audio channels
        grid.addWidget(QLabel("Channels:"), 1, 0)
        self.channels = QComboBox()
        self.channels.addItems(["Original", "Mono (1.0)", "Stereo (2.0)", "5.1", "7.1"])
        grid.addWidget(self.channels, 1, 1)

        # Audio bitrate
        grid.addWidget(QLabel("Audio Bitrate:"), 2, 0)
        self.audio_bitrate = QComboBox()
        self.audio_bitrate.addItems(["64k", "96k", "128k", "160k", "192k", "256k", "320k"])
        self.audio_bitrate.setCurrentText("160k")
        grid.addWidget(self.audio_bitrate, 2, 1)

        # Audio sample rate
        grid.addWidget(QLabel("Sample Rate:"), 3, 0)
        self.samplerate = QComboBox()
        self.samplerate.addItems(["Original", "44100 Hz", "48000 Hz", "96000 Hz"])
        grid.addWidget(self.samplerate, 3, 1)

        # Audio tracks selection
        grid.addWidget(QLabel("Audio Track(s):"), 4, 0)
        self.audio_track_combo = QComboBox()
        self.audio_track_combo.addItem("Auto (first)", userData='auto')
        self.audio_track_combo.addItem("All tracks", userData='all')
        grid.addWidget(self.audio_track_combo, 4, 1)

        # Volume adjustment
        grid.addWidget(QLabel("Volume:"), 5, 0)
        volume_layout = QHBoxLayout()
        self.volume_slider = QSlider(Qt.Orientation.Horizontal)
        self.volume_slider.setRange(0, 200)
        self.volume_slider.setValue(100)
        self.volume_slider.setToolTip("Adjust audio volume. 100% is original volume.")
        self.volume_label = QLabel("100%")
        self.volume_label.setMinimumWidth(40)
        volume_layout.addWidget(self.volume_slider)
        volume_layout.addWidget(self.volume_label)
        grid.addLayout(volume_layout, 5, 1)
        self.volume_slider.valueChanged.connect(lambda value: self.volume_label.setText(f"{value}%"))

        # Audio normalization
        self.normalize_checkbox = QCheckBox("Normalize Audio (Loudnorm)")
        self.normalize_checkbox.setToolTip("Apply two-pass loudness normalization. This may significantly increase conversion time.")
        grid.addWidget(self.normalize_checkbox, 6, 0, 1, 2)

        audio_group.setLayout(grid)
        layout.addWidget(audio_group)
        self.setLayout(layout)

    def populate_audio_tracks(self, audio_meta):
        self.audio_track_combo.clear()
        self.audio_track_combo.addItem("Auto (first)", userData='auto')
        self.audio_track_combo.addItem("All tracks", userData='all')
        if audio_meta:
            for a in audio_meta:
                pos = a.get('pos', 0)
                lang = a.get('lang', 'und')
                desc = f"Track {pos} ({lang})"
                self.audio_track_combo.addItem(desc, userData=pos)

    def get_audio_settings(self):
        return {
            'codec': self.audio_codec.currentText(),
            'channels': self.channels.currentText(),
            'bitrate': self.audio_bitrate.currentText(),
            'samplerate': self.samplerate.currentText(),
            'track_selection': self.audio_track_combo.currentData(),
            'volume': self.volume_slider.value() / 100.0,
            'normalize': self.normalize_checkbox.isChecked()
        }
