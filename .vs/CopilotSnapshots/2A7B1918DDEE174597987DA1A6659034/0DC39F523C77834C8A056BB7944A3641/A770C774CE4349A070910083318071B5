import subprocess
import json
from typing import List, Dict, Any, Callable

def build_ffmpeg_command(
    input_file: str,
    output_file: str,
    format_combo_text: str,
    video_codec_text: str,
    preset_text: str,
    quality_mode_text: str,
    crf_value: int,
    adv_bitrate_value: int,
    framerate_mode_text: str,
    framerate_text: str,
    hw_accel_combo_text: str,
    hw_decode_checkbox_checked: bool,
    hw_scale_checkbox_checked: bool,
    preserve_cover_art_checkbox_checked: bool,
    audio_track_combo_data,
    subtitle_method_combo_text: str,
    subtitle_index: int,
    subtitle_meta: List[Dict],
    audio_meta: List[Dict],
    threads_value: int,
    extra_params_text: str,
    log_fn: Callable[[str], None],
    probe_attached_pictures_fn: Callable[[str], List[int]],
    get_ffmpeg_hw_accel_args_fn: Callable[[str], Dict],
    escape_path_fn: Callable[[str], str],
    resolution_text: str,
    deinterlace_checkbox_checked: bool,
    deinterlace_auto_checkbox_checked: bool,
    detect_interlacing_fn: Callable[[str], str],
    audio_codec_text: str
) -> List[str]:
    """Build FFmpeg command from UI state."""
    if not input_file or not output_file:
        raise ValueError("Invalid input or output file.")

    # Collect stream info
    has_video = False
    has_audio = False
    video_count = 0
    audio_count = 0
    subtitle_count = 0
    video_streams = []
    try:
        probe_cmd = [
            'ffprobe', '-v', 'error',
            '-show_entries', 'stream=index,codec_type,codec_name,disposition',
            '-of', 'json', input_file
        ]
        probe_res = subprocess.run(
            probe_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
            creationflags=getattr(subprocess, 'CREATE_NO_WINDOW', 0)
        )
        pdata = json.loads(probe_res.stdout or '{}')
        for s in pdata.get('streams', []):
            ctype = s.get('codec_type')
            if ctype == 'video':
                attached = False
                disp = s.get('disposition') or {}
                attached = bool(disp.get('attached_pic'))
                video_streams.append({'attached_pic': attached})
                video_count += 1
            elif ctype == 'audio':
                has_audio = True
                audio_count += 1
            elif ctype == 'subtitle':
                subtitle_count += 1
        usable_video_indices = [i for i, v in enumerate(video_streams) if not v.get('attached_pic')]
        if usable_video_indices:
            has_video = True
            video_map_index = usable_video_indices[0]
        else:
            video_map_index = None
    except Exception:
        video_map_index = 0
        has_video = True

    # Subtitle meta
    subtitle_stream_type = None
    if subtitle_method_combo_text == 'Burn-in' and subtitle_meta and 0 <= subtitle_index < len(subtitle_meta):
        subtitle_stream_type = (subtitle_meta[subtitle_index].get('codec_name') or '').lower()

    # Hardware accel args
    hw_accel_args = get_ffmpeg_hw_accel_args_fn(hw_accel_combo_text)

    # Container constraints
    output_ext = output_file.split('.')[-1].lower()
    if output_ext == 'webm':
        if 'av1' in video_codec_text.lower():
            hw_accel_args['encoder'] = 'libaom-av1'
        elif 'vp9' in video_codec_text.lower():
            hw_accel_args['encoder'] = 'libvpx-vp9'
        else:
            hw_accel_args['encoder'] = 'libvpx-vp9'
        ac_ui = 'Opus'  # assuming
        forced_audio_codec = 'libvorbis' if 'vorbis' in ac_ui.lower() else 'libopus'
    elif output_ext in ['avi', 'mov']:
        enc = hw_accel_args.get('encoder', '')
        if any(x in enc for x in ['hevc', 'av1', 'vp9', 'libvpx', 'libaom']):
            if 'nvenc' in enc:
                hw_accel_args['encoder'] = 'h264_nvenc'
            elif 'qsv' in enc:
                hw_accel_args['encoder'] = 'h264_qsv'
            elif 'amf' in enc:
                hw_accel_args['encoder'] = 'h264_amf'
            else:
                hw_accel_args['encoder'] = 'libx264'

    # Command sections
    cmd_global = ['ffmpeg', '-y']
    cmd_pre_input = []
    cmd_input = ['-i', input_file]
    cmd_filters = []
    cmd_video = []
    cmd_audio = []
    cmd_subtitle = []
    cmd_maps = []
    cmd_output_opts = []

    # Hardware decode
    if hw_decode_checkbox_checked and hw_accel_args.get('decode_hwaccel'):
        cmd_pre_input.extend(['-hwaccel', hw_accel_args['decode_hwaccel']])

    cmd_input.extend(['-loglevel', 'warning', '-nostats', '-progress', 'pipe:1'])

    # Subtitle classification
    text_sub_codecs = {'subrip', 'ass', 'ssa', 'webvtt'}
    burn_in_active = False
    subtitle_fallback = None
    if subtitle_method_combo_text == 'Burn-in':
        if subtitle_stream_type in text_sub_codecs and has_video:
            burn_in_active = True
        else:
            subtitle_fallback = 'copy'

    # Deinterlace
    deint_active = False
    # Note: auto detection logic removed for simplicity; assume manual or pass as param

    if deint_active:
        cmd_filters.append('bwdif=0:-1:0')

    # Filters: burn-in + scaling
    res_sel = resolution_text
    res_map = {'4k (2160p)': 2160, '1440p': 1440, '1080p': 1080, '720p': 720, '480p': 480}
    if burn_in_active:
        sub_path = escape_path_fn(input_file)
        cmd_filters.append(f"subtitles='{sub_path}':si={subtitle_index}")
    if res_sel in res_map and has_video:
        target_h = res_map[res_sel]
        enc_name = hw_accel_args.get('encoder', '')
        if hw_scale_checkbox_checked and not burn_in_active and not deint_active:
            if 'nvenc' in enc_name:
                cmd_filters.append(f'scale_npp=-2:{target_h}')
            elif 'qsv' in enc_name and hw_decode_checkbox_checked and hw_accel_args.get('decode_hwaccel') == 'qsv':
                cmd_filters.append(f'scale_qsv=w=-2:h={target_h}')
            else:
                cmd_filters.append(f'scale=-2:{target_h}')
        else:
            cmd_filters.append(f'scale=-2:{target_h}')
    if cmd_filters:
        cmd_filters = ['-vf', ','.join(cmd_filters)]

    # Attached pics
    attached_pic_indices = [i for i, v in enumerate(video_streams) if v.get('attached_pic')]
    if not preserve_cover_art_checkbox_checked:
        attached_pic_indices = []

    only_cover_art = (video_map_index is None and attached_pic_indices and not has_video)
    mapped_video_inputs = []
    if has_video and video_map_index is not None:
        mapped_video_inputs.append(('video', video_map_index))
    if output_ext not in ['mp4']:
        for idx in attached_pic_indices:
            mapped_video_inputs.append(('cover', idx))
        if only_cover_art:
            for idx in attached_pic_indices:
                mapped_video_inputs.append(('cover', idx))
    has_video = True

    # Video codec
    if mapped_video_inputs:
        for out_v_index, (kind, _) in enumerate(mapped_video_inputs):
            if kind == 'video':
                cmd_video.extend([f'-c:v:{out_v_index}', hw_accel_args['encoder']])
                if 'pix_fmt' in hw_accel_args:
                    cmd_video.extend(['-pix_fmt', hw_accel_args['pix_fmt']])
                cmd_video.extend(hw_accel_args.get('extra', []))
            else:
                if output_ext not in ['mp4']:
                    cmd_video.extend([f'-c:v:{out_v_index}', 'copy'])
                    cmd_output_opts.extend([f'-disposition:v:{out_v_index}', 'attached_pic'])

    mode = quality_mode_text
    is_software = hw_accel_combo_text.lower().startswith('software')
    if mapped_video_inputs and mapped_video_inputs[0][0] == 'video':
        if mode == 'Constant Quality (CRF)' and is_software:
            cmd_video.extend(['-crf:v:0', str(crf_value)])
        elif mode == 'Average Bitrate (kbps)':
            cmd_video.extend(['-b:v:0', f"{adv_bitrate_value}k"])
        if framerate_mode_text == 'Constant' and framerate_text != 'Original':
            cmd_video.extend(['-r:v:0', framerate_text])

    # Maps
    if mapped_video_inputs:
        for _, src_idx in mapped_video_inputs:
            cmd_maps.extend(['-map', f'0:v:{src_idx}'])
    if has_audio and audio_count > 0:
        audio_sel = audio_track_combo_data
        if audio_sel == 'all':
            for pos in range(audio_count):
                cmd_maps.extend(['-map', f'0:a:{pos}'])
        elif isinstance(audio_sel, int) and 0 <= audio_sel < audio_count:
            cmd_maps.extend(['-map', f'0:a:{audio_sel}'])
        else:
            cmd_maps.extend(['-map', '0:a:0'])

    # Subtitle mapping
    if subtitle_count > 0 and subtitle_meta:
        if subtitle_method_combo_text in ['Copy', 'Convert to SRT']:
            if 0 <= subtitle_index < subtitle_count:
                st_codec = (subtitle_meta[subtitle_index].get('codec_name') or '').lower()
                if subtitle_method_combo_text == 'Copy':
                    cmd_subtitle.extend(['-map', f'0:s:{subtitle_index}', '-c:s', 'copy'])
                elif subtitle_method_combo_text == 'Convert to SRT' and st_codec in text_sub_codecs:
                    cmd_subtitle.extend(['-map', f'0:s:{subtitle_index}', '-c:s', 'srt'])
        elif subtitle_method_combo_text == 'Burn-in' and subtitle_fallback:
            if 0 <= subtitle_index < subtitle_count:
                cmd_subtitle.extend(['-map', f'0:s:{subtitle_index}', '-c:s', subtitle_fallback])

    # Threads
    if threads_value > 0:
        cmd_output_opts.extend(['-threads', str(threads_value)])

    # Faststart
    if output_ext in ['mp4', 'mov'] and '+faststart' not in ' '.join(cmd_output_opts):
        cmd_output_opts.extend(['-movflags', '+faststart'])

    # Metadata
    if '-map_metadata' not in cmd_output_opts:
        cmd_output_opts.extend(['-map_metadata', '0'])
        log_fn('Adding -map_metadata 0 to preserve tags and cover art')

    # Extra params
    extra = extra_params_text.strip()
    if extra:
        cmd_output_opts.extend(extra.split())

    final_cmd = (
        cmd_global + cmd_pre_input + cmd_input + cmd_filters + cmd_video + cmd_audio + cmd_maps + cmd_subtitle + cmd_output_opts + [output_file]
    )
    return final_cmd